     {
       "name": "Test Invalid Employee Type",
       "request": {
         "method": "POST",
         "header": [
           { "key": "Content-Type", "value": "application/json" }
         ],
         "url": {
           "raw": "{{baseUrl}}/api/employees",
           "host": ["{{baseUrl}}"],
           "path": ["api", "employees"]
         },
         "body": {
           "mode": "raw",
           "raw": "{\n  \"user_id\": 999,\n  \"employee_type\": \"INVALID_TYPE\",\n  \"hire_date\": \"2025-06-20\",\n  \"salary\": 3000\n}"
         }
       },
       "event": [
         {
           "listen": "test",
           "script": {
             "type": "text/javascript",
             "exec": [
               "pm.test(\"Status code is 400 for invalid type\", function () {",
               "    pm.response.to.have.status(400);",
               "});",
               "const json = pm.response.json();",
               "pm.test(\"Error message contains valid types\", function () {",
               "    pm.expect(json.error).to.include('Invalid employee type');",
               "    pm.expect(json.validTypes).to.be.an('array');",
               "    pm.expect(json.validTypes).to.include('CLEANER');",
               "    pm.expect(json.validTypes).to.include('DRIVER');",
               "    pm.expect(json.validTypes).to.include('ADMIN');",
               "    pm.expect(json.validTypes).to.include('MANAGER');",
               "});"
             ]
           }
         }
       ]
     },
