{
	"name": "👷 Employee Management v2.0",
	"description": "Enhanced employee management with skills tracking and location assignment",
	"item": [
		{
			"name": "Get All Employees",
			"request": {
				"method": "GET",
				"header": [],
				"url": {
					"raw": "{{baseUrl}}/api/employees?limit=20&location_id={{locationId}}&position=CLEANER",
					"host": ["{{baseUrl}}"],
					"path": ["api", "employees"],
					"query": [
						{
							"key": "limit",
							"value": "20"
						},
						{
							"key": "location_id",
							"value": "{{locationId}}"
						},
						{
							"key": "position",
							"value": "CLEANER"
						}
					]
				}
			}
		},
		{
			"name": "Create Employee",
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n    \"user_id\": {{userId}},\n    \"position\": \"CLEANER\",\n    \"hourly_rate\": 28.50,\n    \"hire_date\": \"2025-06-25\",\n    \"location_id\": {{locationId}},\n    \"skills\": [\"carpet_cleaning\", \"window_cleaning\", \"car_wash\", \"upholstery_cleaning\"],\n    \"is_available\": true,\n    \"notes\": \"Experienced cleaner with 3 years in the industry\"\n}"
				},
				"url": {
					"raw": "{{baseUrl}}/api/employees",
					"host": ["{{baseUrl}}"],
					"path": ["api", "employees"]
				}
			}
		},
		{
			"name": "Get Employee by Code",
			"request": {
				"method": "GET",
				"header": [],
				"url": {
					"raw": "{{baseUrl}}/api/employees/code/EMP-000001",
					"host": ["{{baseUrl}}"],
					"path": ["api", "employees", "code", "EMP-000001"]
				}
			}
		},
		{
			"name": "Get Employees by Position",
			"request": {
				"method": "GET",
				"header": [],
				"url": {
					"raw": "{{baseUrl}}/api/employees/position/CLEANER?location_id={{locationId}}",
					"host": ["{{baseUrl}}"],
					"path": ["api", "employees", "position", "CLEANER"],
					"query": [
						{
							"key": "location_id",
							"value": "{{locationId}}"
						}
					]
				}
			}
		},
		{
			"name": "Get Employees by Location",
			"request": {
				"method": "GET",
				"header": [],
				"url": {
					"raw": "{{baseUrl}}/api/employees/location/{{locationId}}?is_available=true",
					"host": ["{{baseUrl}}"],
					"path": ["api", "employees", "location", "{{locationId}}"],
					"query": [
						{
							"key": "is_available",
							"value": "true"
						}
					]
				}
			}
		},
		{
			"name": "Search Employees",
			"request": {
				"method": "GET",
				"header": [],
				"url": {
					"raw": "{{baseUrl}}/api/employees/search?query=maria&skills=carpet_cleaning&location_id={{locationId}}",
					"host": ["{{baseUrl}}"],
					"path": ["api", "employees", "search"],
					"query": [
						{
							"key": "query",
							"value": "maria"
						},
						{
							"key": "skills",
							"value": "carpet_cleaning"
						},
						{
							"key": "location_id",
							"value": "{{locationId}}"
						}
					]
				}
			}
		},
		{
			"name": "Add Skill to Employee",
			"request": {
				"method": "PUT",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n    \"skill\": \"pressure_washing\"\n}"
				},
				"url": {
					"raw": "{{baseUrl}}/api/employees/{{employeeId}}/skills",
					"host": ["{{baseUrl}}"],
					"path": ["api", "employees", "{{employeeId}}", "skills"]
				}
			}
		},
		{
			"name": "Remove Skill from Employee",
			"request": {
				"method": "DELETE",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n    \"skill\": \"window_cleaning\"\n}"
				},
				"url": {
					"raw": "{{baseUrl}}/api/employees/{{employeeId}}/skills",
					"host": ["{{baseUrl}}"],
					"path": ["api", "employees", "{{employeeId}}", "skills"]
				}
			}
		},
		{
			"name": "Update Employee Availability",
			"request": {
				"method": "PUT",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n    \"is_available\": false,\n    \"reason\": \"On vacation until next week\"\n}"
				},
				"url": {
					"raw": "{{baseUrl}}/api/employees/{{employeeId}}/availability",
					"host": ["{{baseUrl}}"],
					"path": ["api", "employees", "{{employeeId}}", "availability"]
				}
			}
		}
	]
},
{
	"name": "📋 Order Management v2.0",
	"description": "Simplified order management with single service per order and employee assignment",
	"item": [
		{
			"name": "Get All Orders",
			"request": {
				"method": "GET",
				"header": [],
				"url": {
					"raw": "{{baseUrl}}/api/orders?limit=20&status=PENDING&location_id={{locationId}}",
					"host": ["{{baseUrl}}"],
					"path": ["api", "orders"],
					"query": [
						{
							"key": "limit",
							"value": "20"
						},
						{
