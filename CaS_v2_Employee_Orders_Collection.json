			"name": "Search Orders",
			"request": {
				"method": "GET",
				"header": [],
				"url": {
					"raw": "{{baseUrl}}/api/orders/search?query=carpet&service_type=CARPET_CLEANING&date_from=2025-06-01&date_to=2025-06-30",
					"host": ["{{baseUrl}}"],
					"path": ["api", "orders", "search"],
					"query": [
						{
							"key": "query",
