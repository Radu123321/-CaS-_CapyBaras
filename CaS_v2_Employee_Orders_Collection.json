				],
				"body": {
					"mode": "raw",
					"raw": "{\n    \"assigned_employee_id\": {{employeeId}},\n    \"assignment_notes\": \"Assigned based on carpet cleaning expertise\"\n}"
				},
				"url": {
					"raw": "{{baseUrl}}/api/orders/{{orderId}}/assign",
					"host": ["{{baseUrl}}"],
					"path": ["api", "orders", "{{orderId}}", "assign"]
				}
			}
		},
		{
			"name": "Start Order",
			"request": {
				"method": "PUT",
				"header": [
