# ==============================================
# CaS (Cleaning Web Simulator) - Environment Configuration
# ==============================================

# Database Configuration
# ==============================================
DB_HOST=localhost
DB_PORT=5432
DB_NAME=twproject
DB_USER=postgres
DB_PASS=

# Server Configuration
# ==============================================
PORT=8000
NODE_ENV=development

# SMTP Email Configuration
# ==============================================
# Pentru Gmail (recomandat pentru testing):
# 1. Activează 2FA în contul Gmail
# 2. Generează App Password: https://myaccount.google.com/apppasswords
# 3. Folosește App Password în loc de parola normală

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password-here
SMTP_FROM=CaS System <your-email@gmail.com>

# Pentru alte provideri SMTP:
# Outlook/Hotmail: smtp-mail.outlook.com:587
# Yahoo: smtp.mail.yahoo.com:587
# Custom SMTP: your-smtp-server.com:587

# Alert Configuration
# ==============================================
ALERT_EMAIL_ENABLED=true
ALERT_WEBSOCKET_ENABLED=true
ALERT_RSS_ENABLED=true
ALERT_DEFAULT_RECIPIENTS=admin@company.com,manager@company.com
ALERT_RETRY_ATTEMPTS=3

# Logging Configuration
# ==============================================
LOG_LEVEL=info
LOG_FILE_ENABLED=true

# Scheduler Configuration
# ==============================================
SCHEDULER_ENABLED=true

# Security Configuration
# ==============================================
JWT_SECRET=your-jwt-secret-key-here
BCRYPT_ROUNDS=10

# Development/Testing Configuration
# ==============================================
# Pentru testing cu MailHog (local SMTP server):
# SMTP_HOST=localhost
# SMTP_PORT=1025
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=test@cas-system.local

# Pentru testing cu Ethereal Email (https://ethereal.email/):
# SMTP_HOST=smtp.ethereal.email
# SMTP_PORT=587
# SMTP_USER=generated-user@ethereal.email
# SMTP_PASS=generated-password